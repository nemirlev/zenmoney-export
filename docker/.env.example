# Development-only credentials for the PostgreSQL container.
POSTGRES_USER=zenexport
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=zenexport

# The example stack communicates over its private Docker network, so TLS is disabled here.
DB_URL=postgres://zenexport:replace-with-a-strong-local-password@postgres:5432/zenexport?sslmode=disable
ZEN_API_TOKEN=replace-with-your-zenmoney-api-token

# The exporter is built from the current checkout by default so it matches the mounted migrations.
# To use a schema-compatible prebuilt image, set both variables below.
# ZENEXPORT_IMAGE=registry.example.com/zenexport:v2.1.0
# ZENEXPORT_PULL_POLICY=always
