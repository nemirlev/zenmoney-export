# Development-only credentials for the PostgreSQL container.
POSTGRES_USER=zenexport
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=zenexport

# The example stack communicates over its private Docker network, so TLS is disabled here.
DB_URL=postgres://zenexport:replace-with-a-strong-local-password@postgres:5432/zenexport?sslmode=disable
ZEN_API_TOKEN=replace-with-your-zenmoney-api-token
# Optional: increase this for exceptionally large full synchronization responses.
ZEN_MAX_RESPONSE_SIZE_MB=256

# Read-only financial analytics MCP server. docker-compose.mcp.yml maps DB_URL above to
# ZENMCP_DB_URL inside the container, joins the exporter network, and forces bearer authentication.
# By default every ZenMoney user in this database is available. Optionally uncomment a restrictive
# numeric allowlist when this MCP deployment must expose only specific users.
# ZENMCP_USER_IDS=12345,67890
# Replace this placeholder with `openssl rand -hex 32`; never commit the generated value.
ZENMCP_BEARER_TOKEN=replace-me
ZENMCP_PORT=8080
ZENMCP_ENDPOINT=/mcp
ZENMCP_LOG_LEVEL=info
ZENMCP_ALLOWED_ORIGINS=
ZENMCP_REPORT_TIMEZONE=Europe/Moscow
ZENMCP_MAX_PERIOD_DAYS=3660
ZENMCP_DEFAULT_PAGE_SIZE=50
ZENMCP_MAX_PAGE_SIZE=100
ZENMCP_MAX_CHART_POINTS=400
ZENMCP_MAX_FILTER_VALUES=100
ZENMCP_MAX_REQUEST_BODY_BYTES=1048576
ZENMCP_STALE_AFTER=24h
ZENMCP_REQUEST_TIMEOUT=30s

# docker-compose.postgres.yml creates docker_default by default. Override this only when the
# exporter stack was started with a different Compose project/network name.
# ZENEXPORT_DOCKER_NETWORK=my_exporter_project_default

# The exporter is built from the current checkout by default so it matches the mounted migrations.
# To use a schema-compatible prebuilt image, set both variables below.
# ZENEXPORT_IMAGE=registry.example.com/zenexport:v2.1.0
# ZENEXPORT_PULL_POLICY=always

# The MCP server is also built from the current checkout by default.
# ZENMCP_IMAGE=registry.example.com/zenmcp:v2.1.0
# ZENMCP_PULL_POLICY=always
